{
  "description": "Kullanım sayacı ve ajan ofisi. İçerik gönderilmez. Kapatmak için MERGEN_KULLANIM=0.",
  "hooks": {
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kullanim.sh\"; exit 0; }\n& ([scriptblock]::Create((Get-Content -Raw -LiteralPath \"${CLAUDE_PLUGIN_ROOT}/hooks/kullanim.ps1\")))",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/ofis.mjs",
              "claude"
            ]
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{ sh \"${CLAUDE_PLUGIN_ROOT}/hooks/kullanim.sh\"; exit 0; }\n& ([scriptblock]::Create((Get-Content -Raw -LiteralPath \"${CLAUDE_PLUGIN_ROOT}/hooks/kullanim.ps1\")))",
            "async": true
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/ofis.mjs",
              "claude"
            ]
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/ofis.mjs",
              "claude"
            ]
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "async": true,
            "timeout": 5,
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/ofis.mjs",
              "claude"
            ]
          }
        ]
      }
    ]
  }
}
